{
  "name": "portfolio-real-estate",
  "version": "1.0.0",
  "description": "賃貸不動産ポートフォリオサイト",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:gh": "GITHUB_PAGES=true vite build",
    "preview": "vite preview",
    "lint": "eslint .",
