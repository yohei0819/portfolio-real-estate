    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "stylus": "^0.63.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "gsap": "^3.12.5"
  }
