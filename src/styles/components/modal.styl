// ==========================================
// 物件詳細の追加機能
//   - 画像ギャラリー（クリックで拡大）
//   - ライトボックス（拡大モーダル）
//   - お問い合わせフォーム（モーダル）
//   - SNS シェアボタン
// ==========================================

// ------------------------------------------
// ギャラリー項目（button 化）
// ------------------------------------------
.detail__gallery-item
  position relative
  display flex
  flex-direction column
  align-items center
  justify-content center
  gap 6px
  height 120px
  border none
  border-radius $border-radius
  cursor pointer
  color rgba(0, 0, 0, 0.55)
  font-size $font-size-sm
  font-family $font-family
  overflow hidden
  transition transform $transition-base, box-shadow $transition-base

  &:hover
    transform translateY(-3px)
    box-shadow $shadow-md

  &:focus-visible
    outline 3px solid $primary
    outline-offset 2px

  .detail__gallery-icon
    font-size 1.5rem
    opacity 0.7

  .detail__gallery-label
    font-weight bold

// ------------------------------------------
// ライトボックス
// ------------------------------------------
.lightbox
  position fixed
  inset 0
  z-index 1000
  display flex
  align-items center
  justify-content center
  opacity 0
  transition opacity $transition-base

  &.is-open
    opacity 1

  &__overlay
    position absolute
    inset 0
    background rgba(0, 0, 0, 0.85)
    cursor pointer

  &__content
    position relative
    z-index 1
    width min(90vw, 900px)
    display flex
    align-items center
    justify-content center
    gap 12px

  &__figure
    flex 1
    margin 0
    display flex
    flex-direction column
    align-items center
    gap 16px

  &__image
    width 100%
    height min(60vh, 480px)
    border-radius $border-radius-lg
    box-shadow $shadow-lg
    display flex
    align-items center
    justify-content center
    transform scale(0.97)
    transition transform $transition-base

    .lightbox.is-open &
      transform scale(1)

  &__image-icon
    font-size 3rem
    opacity 0.5

  &__caption
    color #fff
    font-size $font-size-lg
    font-weight bold
    text-align center

  &__counter
    position absolute
    bottom -36px
    left 50%
    transform translateX(-50%)
    color rgba(255, 255, 255, 0.85)
    font-size $font-size-sm

  &__close
    position absolute
    top -44px
    right 0
    width 40px
    height 40px
    border none
    border-radius 50%
    background rgba(255, 255, 255, 0.15)
    color #fff
    font-size 1.1rem
    cursor pointer
    transition background $transition-base

    &:hover
      background rgba(255, 255, 255, 0.3)

  &__nav
    flex-shrink 0
    width 48px
    height 48px
    border none
    border-radius 50%
    background rgba(255, 255, 255, 0.15)
    color #fff
    font-size 1.8rem
    line-height 1
    cursor pointer
    transition background $transition-base

    &:hover
      background rgba(255, 255, 255, 0.3)

    &:focus-visible
      outline 2px solid #fff
      outline-offset 2px

  +sp()
    &__content
      width 94vw
      gap 6px

    &__nav
      width 40px
      height 40px
      font-size 1.4rem

    &__image
      height 50vh

// ------------------------------------------
// お問い合わせモーダル
// ------------------------------------------
.contact-modal
  position fixed
  inset 0
  z-index 1000
  display flex
  align-items center
  justify-content center
  padding 20px
  opacity 0
  transition opacity $transition-base

  &.is-open
    opacity 1

  &__overlay
    position absolute
    inset 0
    background rgba(0, 0, 0, 0.6)
    cursor pointer

  &__dialog
    position relative
    z-index 1
    width min(92vw, 520px)
    max-height 90vh
    overflow-y auto
    background $bg-white
    border-radius $border-radius-lg
    box-shadow $shadow-lg
    padding 32px
    transform translateY(16px)
    transition transform $transition-base

    .contact-modal.is-open &
      transform translateY(0)

    +sp()
      padding 24px 20px

  &__close
    position absolute
    top 14px
    right 14px
    width 34px
    height 34px
    border none
    border-radius 50%
    background $bg-gray
    color $text-gray
    font-size 1rem
    cursor pointer
    transition background $transition-base

    &:hover
      background $border-color

  &__title
    font-size $font-size-2xl
    font-weight bold
    margin-bottom 4px

  &__subtitle
    font-size $font-size-base
    color $text-gray
    margin-bottom 24px

  &__success
    text-align center
    padding 20px 0

  &__success-icon
    font-size 3rem
    margin-bottom 12px

  &__success-title
    font-size $font-size-xl
    font-weight bold
    margin-bottom 12px

  &__success-text
    font-size $font-size-base
    color $text-gray
    line-height 1.7
    margin-bottom 24px

// ------------------------------------------
// お問い合わせフォーム
// ------------------------------------------
.contact-form
  &__field
    margin-bottom 18px

    &--check
      margin-bottom 22px

  &__label
    display block
    font-size $font-size-base
    font-weight bold
    margin-bottom 6px

  &__req
    display inline-block
    font-size $font-size-2xs
    font-weight bold
    color #fff
    background $primary
    border-radius $border-radius
    padding 1px 6px
    margin-left 4px
    vertical-align middle

  &__opt
    display inline-block
    font-size $font-size-2xs
    font-weight bold
    color $text-gray
    background $bg-gray
    border-radius $border-radius
    padding 1px 6px
    margin-left 4px
    vertical-align middle

  &__input,
  &__select,
  &__textarea
    width 100%
    padding 11px 12px
    border 1px solid $border-color
    border-radius $border-radius
    font-size $font-size-base
    font-family $font-family
    box-sizing border-box
    transition border-color $transition-base, box-shadow $transition-base

    &:focus
      outline none
      border-color $primary
      box-shadow 0 0 0 3px rgba(230, 0, 51, 0.12)

  &__textarea
    resize vertical
    min-height 96px

  &__select
    appearance none
    background $bg-white $select-arrow no-repeat right 12px center
    cursor pointer

  &__field.has-error &__input,
  &__field.has-error &__select,
  &__field.has-error &__textarea
    border-color $primary

  &__error
    min-height 0
    font-size $font-size-sm
    color $primary
    margin-top 4px

    &:empty
      display none

  &__check
    display flex
    align-items flex-start
    gap 8px
    font-size $font-size-base
    cursor pointer

    input
      margin-top 3px
      width 16px
      height 16px
      accent-color $primary
      flex-shrink 0

  &__submit
    btn-base()
    width 100%
    padding 14px
    border-radius $border-radius-pill
    background $primary
    color #fff
    font-size $font-size-base
    font-weight bold

    &:hover
      background $primary-dark
      transform translateY(-2px)
      box-shadow $shadow-md

// ------------------------------------------
// SNS シェアボタン
// ------------------------------------------
.detail__sidebar-box--share
  text-align center

.share-buttons
  display flex
  justify-content center
  gap 10px

  &__btn
    flex-center()
    width 44px
    height 44px
    border none
    border-radius 50%
    color #fff
    font-size 1.1rem
    font-weight bold
    text-decoration none
    cursor pointer
    transition transform $transition-base, opacity $transition-base

    &:hover
      transform translateY(-3px)
      opacity 0.9

    &:focus-visible
      outline 3px solid $primary
      outline-offset 2px

    &--x
      background #000

    &--fb
      background #1877f2

    &--line
      background #06c755

    &--copy
      background $bg-gray
      color $text-gray

      &:hover
        background $border-color

  &__feedback
    margin-top 12px
    font-size $font-size-sm
    color $primary
    font-weight bold
